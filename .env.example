# GitHub personal access token for higher API rate limits (optional)
GITHUB_TOKEN=

# LLM provider to use: 'ollama' or 'openai' (default: ollama)
LLM_PROVIDER=ollama

# Base URL for the LLM service endpoint (default: http://localhost:11434)
LLM_BASE_URL=http://localhost:11434

# LLM model identifier for script generation (default: qwen2.5:7b)
LLM_MODEL=qwen2.5:7b

# API key for LLM service authentication if needed (optional)
LLM_API_KEY=

# LLM request timeout in seconds (default: 300)
LLM_TIMEOUT_SECONDS=300

# Sampling temperature for LLM text generation (default: 0.4)
LLM_TEMPERATURE=0.4

# Context window size in tokens for LLM generation (default: 8192)
LLM_NUM_CTX=8192

# File path to the Piper TTS ONNX voice model (default: voices/en_US-lessac-medium.onnx)
PIPER_VOICE_PATH=voices/en_US-lessac-medium.onnx

# Output directory for intermediate artifacts and final video (default: output)
OUTPUT_DIR=output

# Video width in pixels (default: 1920)
VIDEO_WIDTH=1920

# Video height in pixels (default: 1080)
VIDEO_HEIGHT=1080

# Video frame rate in frames per second (default: 30)
VIDEO_FPS=30

# Duration to pause between scenes in seconds (default: 0.6)
SCENE_PAUSE_SECONDS=0.6
